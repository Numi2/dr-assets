{
  "consumables": {
    "contrast": "conserved requested_used_remaining ledger",
    "coupling_gel": "conserved requested_used_remaining ledger",
    "empty_state_disables_dependent_measurement": true
  },
  "dynamic_scene_note": "use USD RTX camera route for deforming tissue; Warp ray-caster geometry route is only for compatible static meshes",
  "implementation_status": {
    "native_multimodal_scene_bridge": "not_implemented_in_this_package",
    "production_ingress": "PerfusionScanSceneEvidence",
    "required_patient_binding": "exact live DynamicSurgicalPatient instance and immutable snapshot digest",
    "synthetic_generator": "fixture_only_not_runtime_evidence"
  },
  "failed_modality_policy": "exclude failed modalities, renormalize valid weights, and abstain when evidence is insufficient",
  "fault_states": [
    "ready",
    "degraded",
    "fault"
  ],
  "modalities": [
    {
      "frames": [
        "rgb_left_camera",
        "rgb_right_camera"
      ],
      "id": "stereo_rgb",
      "output": "registered_rgb_pair",
      "update_hz": 30
    },
    {
      "frames": [
        "nir_fluorescence_camera"
      ],
      "id": "nir_icg",
      "output": "fluorescence_intensity_and_time_series",
      "update_hz": 30
    },
    {
      "frames": [
        "speckle_camera",
        "speckle_projection_center"
      ],
      "id": "laser_speckle",
      "output": "relative_perfusion_index",
      "update_hz": 60
    },
    {
      "frames": [
        "thermal_camera"
      ],
      "id": "thermal",
      "output": "surface_temperature_c",
      "update_hz": 30
    },
    {
      "frames": [
        "multispectral_camera"
      ],
      "id": "surface_oxygenation",
      "output": "sto2_fraction",
      "update_hz": 15
    },
    {
      "frames": [
        "depth_reference",
        "structured_light_projector"
      ],
      "id": "depth",
      "output": "depth_and_normals",
      "update_hz": 30
    },
    {
      "frames": [
        "doppler_probe_tip",
        "doppler_beam_axis"
      ],
      "id": "doppler",
      "output": "signed_projected_velocity",
      "update_hz": 100
    },
    {
      "frames": [
        "ultrasound_probe_face",
        "ultrasound_probe_axis"
      ],
      "id": "ultrasound",
      "output": "b_mode_color_flow_and_provisional_relative_lumen_signal",
      "update_hz": 30
    }
  ],
  "registration_requirement": "native bridge must bind every payload hash and raw record ID to exact source and patient target prims in one post-physics SceneEvidenceEnvelope",
  "abstention_policy": {
    "explicit_abstention": true,
    "minimum_usable_modalities": 3,
    "registration_error_m_max": 0.003,
    "timestamp_skew_s_max": 0.05
  },
  "schema": "dr.anmar.multimodal-sensor-contract.v1",
  "fixture_shared_state": "perfusion_network.json plus SyntheticFixtureICGTracerTransport",
  "production_shared_state": "prim-bound modality records plus exact DynamicSurgicalPatient snapshot; no caller condition or recovery scalar"
}
