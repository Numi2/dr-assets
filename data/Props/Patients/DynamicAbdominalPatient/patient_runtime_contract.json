      "regional_perfusion",
      "active_bleeding",
      "fluid_balance",
      "damage",
      "contact_effects",
      "incision",
      "wound_grasp",
      "tissue_state",
      "disabled_legacy_intervention_history",
      "event_stream",
      "condition",
      "procedure_stage"
    ],
    "methods": [
      "patient.snapshot()",
      "patient.observation()",
      "patient.save_snapshot(path)"
    ],
    "serializable": true
  },
  "source_review_status": "source_hardened_unexecuted_current_revision",
  "native_workcell_effect_provider": "not_implemented_for_all_workcells",
  "step_contract": {
