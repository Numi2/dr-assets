    "caller_supplied_wound_capture_cells": "disabled",
    "legacy_robot_interventions": "disabled"
  },
  "current_authority_limitations": [
    "public patient authority and physiology model objects remain mutable",
    "patient interval mutation is preflighted but not atomically staged and committed",
    "bile and generic suction outputs do not debit source compartments",
    "scene evidence is structurally registered but has no environment-issued provider receipt",
    "no stable patient UUID reset generation or mutation revision"
  ],
  "intended_use": "simulation_training",
  "resuscitation_interfaces": {
    "vascular_access": "Frames/vascular_access_connector",
    "airway": "Frames/airway_connector",
    "effect_authority": "environment_owned_post_physics_pump_line_and_airway_evidence"
  },
  "schema": "dr.anmar.dynamic-patient-runtime.v1",
  "snapshot_contract": {
    "includes": [
