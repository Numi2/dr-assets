      "lean",
      "baseline",
      "increased_visceral_fat"
    ],
    "conditions": [
      "healthy",
      "hemorrhage",
      "bowel_ischemia",
      "bile_leak",
      "ureter_injury",
      "liver_tumor",
      "dense_adhesions",
      "postoperative"
    ],
    "procedure_stages": [
      "closed",
      "access_open",
      "exposed",
      "dissection",
      "hemostasis",
      "division",
      "reconstruction",
      "closure",
      "dressed"
    ]
  },
  "required_attributes": [
    "patient.respiration",
    "patient.perfusion",
    "patient.bleeding",
    "patient.vital_signs",
    "patient.tissue_state",
    "patient.incision",
    "patient.wound_grasp",
    "patient.organ_motion",
    "patient.damage",
    "patient.contact_effects",
    "patient.patient_authority",
    "patient.contacts",
    "patient.event_bus",
    "patient.fluids"
  ],
  "disabled_runtime_routes": {
    "patient.incision.advance": "pending exact prim-bound incision provider",
