#usda 1.0
(
    defaultPrim = "NeedleReadyTissueVisualMaterials"
    doc = "DrAnmar visual-only research materials; procedural and not clinically color-calibrated."
    metersPerUnit = 1
    subLayers = [
        @./vendor/nvidia_physicalai_simready_materials_v0_2_0/open_pbr_uber_base_class.usda@
    ]
    upAxis = "Z"
)

def Scope "NeedleReadyTissueVisualMaterials" (
    customData = {
        string drAnmarAssetRole = "render_materials_only"
        bool drAnmarClinicalValidation = false
        bool drAnmarPhysicsAuthority = false
        string drAnmarPrimaryMaterialContext = "OpenPBR_1_1_MaterialX"
        string drAnmarTextureColorContract = "basecolor_sRGB_roughness_and_normal_raw"
    }
)
{
        def Material "Surface" (
            inherits = </open_pbr_uber_base>
        )
        {
            token outputs:surface.connect = </NeedleReadyTissueVisualMaterials/Surface/PreviewSurface.outputs:surface>

            float inputs:base_weight = 1
            color3f inputs:base_color = (0.55, 0.215, 0.185)
            asset inputs:base_color_texture_file = @textures/surface_basecolor.png@ (
                colorSpace = "sRGB"
            )
            float inputs:base_diffuse_roughness = 0.18
            float inputs:base_metalness = 0
            float inputs:specular_weight = 0.16
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_roughness = 0.74
            asset inputs:specular_roughness_texture_file = @textures/surface_roughness.png@ (
                colorSpace = "raw"
            )
            float inputs:specular_ior = 1.38
            float inputs:subsurface_weight = 0.48
            asset inputs:subsurface_weight_texture_file = @textures/surface_subsurface_weight.png@ (
                colorSpace = "raw"
            )
            color3f inputs:subsurface_color = (0.67, 0.3, 0.24)
            float inputs:subsurface_radius = 0.00078
            color3f inputs:subsurface_radius_scale = (1, 0.461538462, 0.230769231)
            float inputs:coat_weight = 0
            bool inputs:geometry_thin_walled = false
            float inputs:geometry_normal_scale = 1
            asset inputs:geometry_normal_texture_file = @textures/surface_normal.png@ (
                colorSpace = "raw"
            )
            bool inputs:geometry_normal_texture_flip_g = false

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </NeedleReadyTissueVisualMaterials/Surface/BaseColorTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </NeedleReadyTissueVisualMaterials/Surface/RoughnessTexture.outputs:r>
                float inputs:ior = 1.38
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 1
                normal3f inputs:normal.connect = </NeedleReadyTissueVisualMaterials/Surface/NormalTexture.outputs:rgb>
                token outputs:surface
            }

            def Shader "Texcoord"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/surface_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Surface/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/surface_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Surface/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/surface_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Surface/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }

