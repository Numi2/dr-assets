                asset inputs:file = @textures/drape_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Drape/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/drape_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Drape/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }

        def Material "Cassette" (
            inherits = </open_pbr_uber_base>
        )
        {
            token outputs:surface.connect = </NeedleReadyTissueVisualMaterials/Cassette/PreviewSurface.outputs:surface>

            float inputs:base_weight = 1
            color3f inputs:base_color = (0.065, 0.08, 0.088)
            asset inputs:base_color_texture_file = @textures/cassette_basecolor.png@ (
                colorSpace = "sRGB"
            )
            float inputs:base_diffuse_roughness = 0.18
            float inputs:base_metalness = 0
            float inputs:specular_weight = 0.14
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_roughness = 0.72
            asset inputs:specular_roughness_texture_file = @textures/cassette_roughness.png@ (
                colorSpace = "raw"
            )
            float inputs:specular_ior = 1.38
            float inputs:subsurface_weight = 0
            color3f inputs:subsurface_color = (0.065, 0.08, 0.088)
            float inputs:subsurface_radius = 0
            color3f inputs:subsurface_radius_scale = (1, 1, 1)
            float inputs:coat_weight = 0
            bool inputs:geometry_thin_walled = false
            float inputs:geometry_normal_scale = 1
            asset inputs:geometry_normal_texture_file = @textures/cassette_normal.png@ (
                colorSpace = "raw"
            )
            bool inputs:geometry_normal_texture_flip_g = false

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </NeedleReadyTissueVisualMaterials/Cassette/BaseColorTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </NeedleReadyTissueVisualMaterials/Cassette/RoughnessTexture.outputs:r>
                float inputs:ior = 1.38
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 1
                normal3f inputs:normal.connect = </NeedleReadyTissueVisualMaterials/Cassette/NormalTexture.outputs:rgb>
                token outputs:surface
            }

            def Shader "Texcoord"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cassette_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Cassette/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cassette_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Cassette/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/cassette_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </NeedleReadyTissueVisualMaterials/Cassette/Texcoord.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }
}
