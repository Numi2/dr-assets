#usda 1.0
(
    defaultPrim = "DrAnmarTissueRenderSupport"
    doc = "Render-only support cassette and drape spanning the 17 mm tissue-to-table offset."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarTissueRenderSupport" (
    customData = {
        string drAnmarAssetRole = "render_support_only"
        bool drAnmarClinicalValidation = false
        bool drAnmarCollisionAuthority = false
        bool drAnmarPhysicsAuthority = false
        double drAnmarSupportedGapM = 0.017
        string drAnmarSupportExplanation = "tissue_bottom_minus_0p003_to_table_plane_minus_0p020"
    }
)
{
    token purpose = "render"

    def Scope "Materials" (
        references = @./materials.usda@</NeedleReadyTissueVisualMaterials>
    )
    {
    }

    def Xform "CassetteGeometry"
    {
        def Cube "RailLeft" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (-0.0425, 0, -0.0055)
            double3 xformOp:scale = (0.0025, 0.029, 0.0025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "RailRight" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (0.0425, 0, -0.0055)
            double3 xformOp:scale = (0.0025, 0.029, 0.0025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "RailAnterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (0, -0.0265, -0.0055)
            double3 xformOp:scale = (0.04, 0.0025, 0.0025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "RailPosterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (0, 0.0265, -0.0055)
            double3 xformOp:scale = (0.04, 0.0025, 0.0025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "ColumnLeftAnterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (-0.0425, -0.0265, -0.012)
            double3 xformOp:scale = (0.0025, 0.0025, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "ColumnLeftPosterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (-0.0425, 0.0265, -0.012)
            double3 xformOp:scale = (0.0025, 0.0025, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "ColumnRightAnterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (0.0425, -0.0265, -0.012)
            double3 xformOp:scale = (0.0025, 0.0025, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "ColumnRightPosterior" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Cassette>
            double3 xformOp:translate = (0.0425, 0.0265, -0.012)
            double3 xformOp:scale = (0.0025, 0.0025, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "SurgicalDrape" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            token purpose = "render"
            rel material:binding = </DrAnmarTissueRenderSupport/Materials/Drape>
            double3 xformOp:translate = (0, 0, -0.0197)
            double3 xformOp:scale = (0.06, 0.045, 0.0003)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
