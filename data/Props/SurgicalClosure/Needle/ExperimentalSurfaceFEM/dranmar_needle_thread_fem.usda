#usda 1.0
(
    defaultPrim = "DrAnmarNeedle"
    doc = "Dr.Anmar 4-0 needle-thread experiment: one task-compatible rigid needle and one NVIDIA Omni Physics surface-FEM strand. Simulator engineering asset; not biomechanical or clinical validation."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarNeedle" (
    assetInfo = {
        string name = "DrAnmarNeedleThreadFEM"
        string version = "0.1.0"
    }
    customData = {
        dictionary drAnmar = {
            bool clinicalValidation = 0
            string representation = "single_rigid_needle_plus_surface_fem_suture"
            string rigidBodyPath = "NeedleRigid"
        }
    }
)
{
    def Xform "NeedleRigid" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./dranmar_needle_entry_proxy.usda@</DrAnmarNeedle>
    )
    {
        rel material:binding:physics = </DrAnmarNeedle/NeedleGripPhysics> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }

    def Material "NeedleGripPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.5
        float physics:restitution = 0
        float physics:staticFriction = 2
        uniform token physxMaterial:frictionCombineMode = "max"
    }

    def Mesh "ThreadFEM" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "OmniPhysicsSurfaceDeformableSimAPI", "PhysicsCollisionAPI", "MaterialBindingAPI", "PhysxSurfaceDeformableBodyAPI"]
    )
    {
