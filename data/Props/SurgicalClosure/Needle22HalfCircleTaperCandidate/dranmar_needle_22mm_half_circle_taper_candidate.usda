#usda 1.0
(
    defaultPrim = "DrAnmarNeedle22HalfCircleTaperCandidate"
    doc = "Inactive 22 mm category-level closure-needle candidate; Physics defaults to none and no clinical or native qualification is claimed."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DrAnmarNeedle22HalfCircleTaperCandidate" (
    prepend references = @./dranmar_needle_22mm_half_circle_taper_candidate_base.usda@
    variants = {
        string Physics = "none"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "none" {
        }
        "physics" (
            prepend payload = @./dranmar_needle_22mm_half_circle_taper_candidate_physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./dranmar_needle_22mm_half_circle_taper_candidate_physx.usda@
        ) {
        }
    }
}
